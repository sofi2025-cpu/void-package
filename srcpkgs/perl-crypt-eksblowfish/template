pre_configure() {
    # Убедимся, что Class::Mix установлен через cpan
    if ! perl -e 'use Class::Mix; print "OK\n"' 2>/dev/null | grep -q OK; then
        echo "Class::Mix не найден. Устанавливаем через cpan..."
        yes | cpan Class::Mix || true
    fi
}

do_configure() {
    perl Build.PL \
        --installdirs vendor \
        --install_base="${DESTDIR}/usr"
}

do_build() {
    ./Build
}

do_check() {
    ./Build test
}

do_install() {
    ./Build install
    find "${DESTDIR}" -name .packlist -o -name perllocal.pod -delete
}

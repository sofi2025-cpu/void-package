pre_configure() {
	# Принудительно убираем флаги, которые musl не поддерживает
	export LDDLFLAGS="-shared"
	export LD="musl-gcc"
	# Убираем relro из флагов
	export PERL_LDFLAGS=""
}

# do_build не нужен — build_style=perl-module сам вызовет Build.PL или Makefile.PL
# Но если хочешь кастомить — оставь. Лучше довериться perl-module.

post_install() {
	vbin install -Dm644 README.pod -t ${DESTDIR}/usr/share/doc/perl-crypt-eksblowfish
}

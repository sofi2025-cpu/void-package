# Template file for 'zoneminder'
pkgname=zoneminder
version=1.38.3
revision=2
system_groups="www-data" # Ensures the target group exists on the user's host OS
build_style=cmake
configure_args="
 -DCMAKE_INSTALL_PREFIX=/usr
 -DZM_WEBDIR=/usr/share/zoneminder/www
 -DZM_CGIDIR=/usr/libexec/zoneminder/cgi-bin
 -DZM_RUNDIR=/run/zoneminder
 -DZM_SOCKDIR=/run/zoneminder
 -DZM_LOGDIR=/var/log/zoneminder
 -DZM_CONFIG_DIR=/etc/zm
 -DZM_CONFIG_SUBDIR=/etc/zm/conf.d
 -DZM_PERL_SUBPREFIX=/usr/lib/perl5/vendor_perl
 -DZM_SYSCONFDIR=/etc/zm
 -DZM_POLKIT_DIR=/usr/share/polkit-1/actions
 -DZM_SYSTEMD_UNITDIR=/usr/lib/systemd/system
 -DZM_MANDIR=/usr/share/man
 -DZM_INCLUDEDIR=/usr/include
 -DZM_CACHEDIR=/var/cache/zoneminder/cache
"
hostmakedepends="
 pkg-config
 pkgconf
 perl
 git
 ninja
 cmake
 "
makedepends="
 libmariadbclient-devel
 mariadb
 apache-devel
 php-devel
 libjpeg-turbo-devel
 libpng-devel
 ffmpeg-devel
 opencv
 iproute2
 net-tools
 pcre2-devel
 libcurl-devel
 pcre-devel
 libgcrypt-devel
 gnutls-devel
 vlc-devel
 libvncserver-devel
 "
depends="
 perl-DBD-mysql
 perl-Date-Manip
 perl-LWP
 perl-DBI
 perl-LWP-Protocol-https
 "
short_desc="Complete video surveillance storage and monitoring solution"
maintainer="Erik Schoepplenberg <erik@puppylinux.com>"
license="GPL-2.0-or-later"
homepage="https://zoneminder.com/"
distfiles="https://github.com/ZoneMinder/zoneminder/archive/refs/tags/"${version}".tar.gz"
checksum=59ed8bcaa2376593873b613149ea299b9055443e6d925689b2bf69c56f2deb79

# Allow xbps-src to connect to GitHub during the build phase
allow_net=yes

post_extract() {
    git init
    git remote add origin https://github.com/ZoneMinder/zoneminder
    git fetch --depth=1 origin "${version}"
    git reset --mixed FETCH_HEAD
    git submodule update --init --recursive
}

post_install() {
    # Установка Perl-модулей через cpanm (только для native x86_64)
    echo "Installing Perl modules via cpanm..."

    perl -e '
        use HTTP::Tiny;
        my $response = HTTP::Tiny->new->get("https://cpanmin.us");
        if ($response->{success}) {
            open(my $fh, ">", "cpanm");
            print $fh $response->{content};
            close($fh);
        } else {
            die "Download failed: $response->{reason}\n";
        }
    '

    chmod +x cpanm

    ./cpanm --notest --no-man-pages -l "${DESTDIR}/usr" \
        Net::WebSocket::Server \
        Net::MQTT::Simple \
        Sys::MemInfo \
        Sys::Mmap \
        Device::SerialPort \
        Number::Bytes::Human

    rm -f cpanm

    # Очистка мусора (pod-файлы и т.п.)
    rm -rf "${DESTDIR}/usr/lib/perl5/client"
    find "${DESTDIR}/usr/lib/perl5/" -type f -name "*.pod" -delete

  mkdir -p ${PKGDESTDIR}/etc/zm/conf.d

  cat > ${PKGDESTDIR}/etc/zm/conf.d/01-system-paths.conf << 'EOF'
ZM_PATH_UNAME=uname
ZM_PATH_IP=/sbin/ip
ZM_PATH_IFCONFIG=/sbin/ifconfig
ZM_PATH_SHUTDOWN=/sbin/shutdown
ZM_PATH_FFMPEG=/usr/bin/ffmpeg
ZM_PATH_DATA=/var/lib/zoneminder
ZM_PATH_LOGS=/var/log/zoneminder
ZM_PATH_CACHE=/var/cache/zoneminder
ZM_PATH_RUN=/run/zoneminder
ZM_PATH_TEMP=/var/lib/zoneminder/temp
ZM_PATH_EVENTS=/var/lib/zoneminder/events
ZM_PATH_IMAGES=/var/lib/zoneminder/images
EOF
}

    mkdir -p usr/lib/perl5/vendor_perl
    mv ${DESTDIR}/usr/lib/perl5/x86_64-linux/* ${DESTDIR}/usr/lib/perl5/vendor_perl/
    rm -rf "${DESTDIR}/usr/lib/perl5/x86_64-linux

    # Runit service block
    mkdir -p "${DESTDIR}/etc/sv/zoneminder"
    cat > "${DESTDIR}/etc/sv/zoneminder/run" << 'EOF'
#!/bin/sh
exec zmpkg.pl start
EOF
    chmod 0755 "${DESTDIR}/etc/sv/zoneminder/run"
}
